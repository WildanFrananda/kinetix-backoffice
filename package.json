{
  "name": "kinetix-backoffice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build && bun scripts/write_csp.ts",
    "check": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tcm -a -s -l -p \"src/**/*.module.css\" . && tsc -p tsconfig.json --noEmit",
    "test": "bunx --bun vitest run",
    "css-types": "tcm -a -s -p \"src/**/*.module.css\" ."
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "otpauth": "9.5.2",
    "typed-css-modules": "0.9.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
