#!/bin/sh
set -eu

: "${KINETIX_DOCS_DIR:?bin/contract compares the calls with a checkout of kinetix-docs: set KINETIX_DOCS_DIR}"

cd "$(dirname "$0")/.."

copy="$(mktemp -d)"
trap 'rm -rf "$copy"' EXIT
cp -R "$KINETIX_DOCS_DIR/src" "$copy/src"

KINETIX_DOCS_DIR="$copy" bunx --bun vitest run --config vitest.contract.config.ts
